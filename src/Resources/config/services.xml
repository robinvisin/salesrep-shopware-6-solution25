<?xml version="1.0"?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <service id="SalesAgent\Service\SalesAgentConfigProvider">
            <argument type="service" id="sales_agent_config.repository"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="SalesAgent\Service\AgentOnlyCategoryProvider">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="SalesAgent\Storefront\Controller\SalesAgentCartNoteController"
        public="true">
        <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService" />
        <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextPersister" />
        <tag name="controller.service_arguments" />
     </service>
     <service id="SalesAgent\Service\SalesAgentGuard" autowire="true" autoconfigure="true" public="false"/>

     <service id="SalesAgent\Storefront\Controller\SalesAgentCartSplitController"
     public="true">
     <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextPersister" />
     <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService" />
     <argument type="service" id="SalesAgent\Service\SalesAgentGuard" />
     <tag name="controller.service_arguments" />
     <call method="setContainer">
        <argument type="service" id="service_container"/>
    </call>
  </service>

<service id="SalesAgent\Subscriber\SalesAgentCartToOrderSubscriber">
    <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextPersister" />
    <tag name="kernel.event_subscriber"/>
</service>
<service id="SalesAgent\Subscriber\SalesAgentSplitOrderSubscriber">
    <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextPersister" />
    <argument type="service" id="order.repository"/>
    <argument type="service" id="SalesAgent\Service\SalesAgentGuard" />
    <tag name="kernel.event_subscriber"/>
</service>

<service id="SalesAgent\Controller\AbandonedCartReminderController" public="true">
    <tag name="controller.service_arguments"/>

    <argument type="service" id="sales_agent_abandoned_cart.repository"/>
    <argument type="service" id="customer.repository"/>
    <argument type="service" id="sales_channel.repository"/>
    <argument type="service" id="sales_channel_domain.repository"/>
    <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
    <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
</service>

<service id="SalesAgent\Controller\SalesAgentValidateSalesAgentEmailActionController" public="true">
    <argument type="service" id="user.repository"/>
    <tag name="controller.service_arguments"/>
    <call method="setContainer">
        <argument type="service" id="service_container"/>
    </call>
</service>

    <service id="SalesAgent\Subscriber\SalesAgentNoteOrderSubscriber">
        <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextPersister" />
        <argument type="service" id="order.repository" />
        <tag name="kernel.event_subscriber" />
    </service>

    <service id="SalesAgent\Controller\OrderClaimController" public="true">
        <argument type="service" id="order.repository"/>
        <argument type="service" id="SalesAgent\Service\OrderCommissionRecalculator"/>
        <call method="setContainer">
            <argument type="service" id="service_container"/>
        </call>
        <tag name="controller.service_arguments"/>
    </service>
    <service id="SalesAgent\Service\OrderClaimRequestService" public="true">
        <argument type="service" id="order.repository"/>
        <argument type="service" id="sales_agent_order_claim_request.repository"/>
        <argument type="service" id="sales_agent_config.repository"/>
        <argument type="service" id="SalesAgent\Service\AgentResolver"/>
        <argument type="service" id="SalesAgent\Service\OrderCommissionRecalculator"/>
    
        <argument type="service" id="user.repository"/>
        <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
        <argument type="service" id="logger"/>
    </service>
    
    
    <service id="SalesAgent\Controller\OrderClaimRequestController" public="true">
        <argument type="service" id="SalesAgent\Service\OrderClaimRequestService"/>
        <call method="setContainer">
            <argument type="service" id="service_container"/>
        </call>
        <tag name="controller.service_arguments"/>
    </service>

    <!-- Resolve claimed agent (order customFields -> agentId) -->
    <service id="SalesAgent\Service\ClaimedAgentResolver">
        <argument type="service" id="sales_agent_config.repository"/>
    </service>

    <service id="SalesAgent\Service\OrderCommissionRecalculator" public="true">
        <argument type="service" id="order.repository"/>
        <argument type="service" id="user.repository"/>
        <argument type="service" id="sales_agent_config.repository"/>
        <argument type="service"  id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        <argument type="service" id="SalesAgent\Service\AgentResolver"/>
        <argument type="service" id="SalesAgent\Service\NumberResolver"/>
        <argument type="service" id="SalesAgent\Service\DiscountCalculator"/>
        <argument type="service" id="SalesAgent\Service\CommissionUpserter"/>
        <argument type="service" id="SalesAgent\Service\ClaimedAgentResolver"/>
        <argument type="service" id="Doctrine\DBAL\Connection" />
        </service>
        <!-- Services-->
        <service id="SalesAgent\Service\AgentResolver" public="false">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="sales_agent_config.repository"/>
            <argument type="service" id="user.repository"/>
        </service>

        <service id="SalesAgent\Service\NumberResolver" public="false">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="SalesAgent\Service\DiscountCalculator" public="false">
            <argument type="service" id="SalesAgent\Service\NumberResolver"/>
        </service>

        <service id="SalesAgent\Service\CommissionUpserter" public="false">
            <argument type="service" id="sales_agent_commission.repository"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="SalesAgent\Core\Checkout\Cart\CustomCartProcessor">
            <tag name="shopware.cart.processor"/>
        </service>
        <service id="SalesAgent\Subscriber\SalesAgentProductPriceOverrideSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
        
        <service id="SalesAgent\Subscriber\CustomerLoginSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- <service id="SalesAgent\Subscriber\SalesAgentHideOrdersWithHiddenCategorySubscriber">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service> -->

        
        <service id="SalesAgent\Core\Content\OrderClaimRequest\OrderClaimRequestDefinition" class="SalesAgent\Core\Content\OrderClaimRequest\OrderClaimRequestDefinition">
            <tag name="shopware.entity.definition"/>
        </service>
        <service id="SalesAgent\Core\Content\SalesAgentCommission\SalesAgentCommissionDefinition" class="SalesAgent\Core\Content\SalesAgentCommission\SalesAgentCommissionDefinition">
            <tag name="shopware.entity.definition"/>
        </service>
      
        <service id="SalesAgent\Repository.SalesAgentConfig" alias="sales_agent_config.repository" />

        <service id="SalesAgent\Subscriber\OrderWrittenSubscriber">
            <argument type="service" id="order.repository" />
            <argument type="service" id="user.repository" />
            <argument type="service" id="sales_agent_config.repository" />
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="SalesAgent\Service\AgentResolver" />
            <argument type="service" id="SalesAgent\Service\NumberResolver" />
            <argument type="service" id="SalesAgent\Service\DiscountCalculator" />
            <argument type="service" id="SalesAgent\Service\CommissionUpserter" />
            <argument type="service" id="Doctrine\DBAL\Connection" />
            <argument type="service" id="logger" />
            <tag name="kernel.event_subscriber" />
        </service>
        <service id="SalesAgent\Subscriber\SalesAgentCategoryAccessSubscriber">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="router"/>
            <tag name="kernel.event_subscriber" />
        </service>
        <service id="SalesAgent\Subscriber\SalesAgentSearchAccessSubscriber" public="false">
            <argument type="service" id="SalesAgent\Service\AgentOnlyCategoryProvider"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="SalesAgent\Subscriber\CommercialReturnSubscriber">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_return_line_item.repository"/>
            <argument type="service" id="SalesAgent\Service\CommissionUpserter"/>
            <argument type="service" id="Doctrine\DBAL\Connection" />
            <argument type="service" id="monolog.logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="SalesAgent\Subscriber\StateTransitionSubscriber">
            <argument type="service" id="SalesAgent\Service\CommissionUpserter"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="order_delivery.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="SalesAgent\Core\Content\SalesAgentConfig\SalesAgentConfigDefinition" class="SalesAgent\Core\Content\SalesAgentConfig\SalesAgentConfigDefinition">
            <tag name="shopware.entity.definition" entity="sales_agent_config"/>
        </service>
        
        <service id="SalesAgent\Cart\SalesAgentPriceProcessor">
            <argument type="service" id="SalesAgent\Service\SalesAgentConfigProvider"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="shopware.cart.processor" priority="4945"/>
        </service>
        <service id="SalesAgent\Cart\SalesAgentShippingPriceProcessor">
            <argument type="service" id="SalesAgent\Service\SalesAgentConfigProvider"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="shopware.cart.processor" priority="-5010"/>
        </service>
        
        <service id="SalesAgent\Storefront\Controller\SalesAgentPriceController">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="sales_agent_config.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="SalesAgent\Controller\SalesKingPayoutActionController" public="true">
            <argument type="service" id="user.repository"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>
        
        <service id="SalesAgent\Storefront\Controller\SalesAgentValidateSalesAgentEmailRouteController" public="true">
            <argument type="service" id="user.repository"/>
            <!-- <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call> -->
            <tag name="controller.service_arguments"/>
        </service>
        <service id="SalesAgent\Storefront\Controller\SalesAgentShippingController"
         class="SalesAgent\Storefront\Controller\SalesAgentShippingController">
           <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService" />
            <argument type="service" id="sales_agent_config.repository" />
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="SalesAgent\Subscriber\ConfirmPageSubscriber">
            <argument type="service" id="SalesAgent\Service\SalesAgentConfigProvider"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="SalesAgent\Subscriber\EarlyShippingEnforcementSubscriber">
            <argument type="service" id="shipping_method.repository"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextPersister"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="SalesAgent\Core\Content\Sitemap\CategoryUrlProvider"
                 decorates="Shopware\Core\Content\Sitemap\Provider\CategoryUrlProvider">
            <argument type="service" id=".inner"/>
            <argument type="service" id="category.repository"/>
        </service>

        <service id="SalesAgent\Core\Content\Sitemap\ProductUrlProvider"
                 decorates="Shopware\Core\Content\Sitemap\Provider\ProductUrlProvider">
            <argument type="service" id=".inner"/>
            <argument type="service" id="category.repository"/>
            <argument type="service" id="product.repository"/>
        </service>

        <service id="SalesAgent\Core\Checkout\AbandonedCart\AbandonedCartDefinition">
            <tag name="shopware.entity.definition" entity="sales_agent_abandoned_cart" />
        </service>
        <service id="SalesAgent\Core\Checkout\AbandonedCart\AbandonedCartManager">
            <argument type="service" id="SalesAgent\Core\Checkout\Cart\CartRepository" />
            <argument type="service" id="sales_agent_abandoned_cart.repository" />
        </service>
            <!-- Commands -->
    <service id="SalesAgent\Command\DeleteAbandonedCartCommand">
        <argument type="service" id="SalesAgent\Core\Checkout\AbandonedCart\AbandonedCartManager" />
        <tag name="console.command" />
    </service>

    <service id="SalesAgent\Command\MarkAbandonedCartCommand">
        <argument type="service" id="SalesAgent\Core\Checkout\AbandonedCart\AbandonedCartManager" />
        <tag name="console.command" />
    </service>

    <service id="SalesAgent\Command\UpdateAbandonedCartCommand">
        <argument type="service" id="SalesAgent\Core\Checkout\AbandonedCart\AbandonedCartManager" />
        <tag name="console.command" />
    </service>
    <service id="SalesAgent\Core\Checkout\Cart\CartRepository">
        <argument type="service" id="Doctrine\DBAL\Connection" />
        <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
    </service>


     <!-- ScheduledTask -->
     <service id="SalesAgent\Service\ScheduledTask\CancelUnpaidOrdersTask">
        <tag name="shopware.scheduled.task" />
    </service>
    <service id="SalesAgent\Service\ScheduledTask\CancelUnpaidOrdersTaskHandler">
        <argument type="service" id="scheduled_task.repository"/>
        <argument type="service" id="order_transaction.repository"/>
        <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
        <tag name="messenger.message_handler"/>
    </service>
     <service id="SalesAgent\Service\ScheduledTask\DeleteAbandonedCartTask">
        <tag name="shopware.scheduled.task" />
    </service>

    <service id="SalesAgent\Service\ScheduledTask\DeleteAbandonedCartTaskHandler">
        <argument type="service" id="scheduled_task.repository" />
        <argument type="service" id="SalesAgent\Core\Checkout\AbandonedCart\AbandonedCartManager" />
        <tag name="messenger.message_handler" />
    </service>

    <service id="SalesAgent\Service\ScheduledTask\UpdateAbandonedCartTask">
        <tag name="shopware.scheduled.task" />
    </service>

    <service id="SalesAgent\Service\ScheduledTask\UpdateAbandonedCartTaskHandler">
        <argument type="service" id="scheduled_task.repository" />
        <argument type="service" id="SalesAgent\Core\Checkout\AbandonedCart\AbandonedCartManager" />
        <tag name="messenger.message_handler" />
    </service>

    <service id="SalesAgent\Service\ScheduledTask\MarkAbandonedCartTask">
        <tag name="shopware.scheduled.task" />
    </service>

    <service id="SalesAgent\Service\ScheduledTask\MarkAbandonedCartTaskHandler">
        <argument type="service" id="scheduled_task.repository" />
        <argument type="service" id="SalesAgent\Core\Checkout\AbandonedCart\AbandonedCartManager" />
        <tag name="messenger.message_handler" />
    </service>

    <service id="SalesAgent\Controller\CustomerConvertController" public="true">
        <argument type="service" id="customer.repository"/>
        <argument type="service" id="sales_channel_domain.repository"/>
        <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
        <argument type="service" id="Shopware\Core\Checkout\Customer\SalesChannel\SendPasswordRecoveryMailRoute"/>
        <call method="setContainer">
            <argument type="service" id="service_container"/>
        </call>
        <tag name="controller.service_arguments"/>
    </service>
    </services>
</container>
