{% sw_extends '@Storefront/storefront/component/shipping/shipping-method.html.twig' %}

{% block component_shipping_method_field %}
    {% set isAgent =
        (context.imitatingUserId is defined and context.imitatingUserId)
        or (context.customer and context.customer.customFields is defined
            and (context.customer.customFields.sales_agent ?? false) in [true, 1, '1'])
    %}
    {% set cfT = shipping.translated.customFields ?? {} %}
    {% set cf  = shipping.customFields ?? {} %}
    {% set isAgentOnly = (cfT.sales_agent_only ?? cf.sales_agent_only ?? 0) in [true, 1, '1'] %}
    {% set limit = page.extensions.saAgentCfg.discountLimit|default(0) %}

    {% set shippingCost = null %}
    {% for delivery in page.cart.deliveries %}
        {% if delivery.shippingMethod.id == shipping.id %}
            {% set shippingCost = delivery.shippingCosts.unitPrice %}
        {% endif %}
    {% endfor %}

    {% if isAgentOnly and not isAgent %}
        <div class="nonvisible-for-customer"></div>
    {% else %}
        {{ parent() }}

        {% if isAgent and shippingCost is not null %}
            {% set current = shipping.customFields.saCustomShippingPrice ?? shippingCost %}
            {% set orig = shippingCost %}

            <div class="sa-shipping-editor mt-3"
                 data-sa-shipping-editor
                 data-shipping-id="{{ shipping.id }}"
                 data-orig="{{ orig|number_format(2, '.', '') }}"
                 data-limit="{{ limit|number_format(2, '.', '') }}">
                <label class="form-label" for="sa-shipping-price-{{ shipping.id }}">
                    Agent shipping price
                </label>

                <div class="input-group">
                    <input id="sa-shipping-price-{{ shipping.id }}"
                           class="form-control js-sa-shipping-input"
                           type="number"
                           step="0.01"
                           min="0"
                           max="{{ orig|number_format(2, '.', '') }}"
                           value="{{ current|number_format(2, '.', '') }}" />
                    <button type="button" class="btn btn-primary js-sa-shipping-apply">
                        Apply shipping price
                    </button>
                </div>

                <div class="mt-1 small text-muted">
                    Discount limit applies automatically (up to −{{ limit|number_format(1, '.', '') }}%).
                </div>
                <div class="mt-1 small text-danger d-none js-sa-shipping-error"></div>
            </div>

            <script>
            (() => {
              if (window.__saShippingEditorInlineLoaded) return;
              window.__saShippingEditorInlineLoaded = true;

              const toCents = (n) => Math.round((Number(n) + 1e-9) * 100);
              const ceilToCents = (n) => Math.ceil((Number(n) + 1e-9) * 100);

              const bind = (root) => {
                const nodes = (root || document).querySelectorAll('[data-sa-shipping-editor]');
                if (!nodes?.length) return;

                nodes.forEach((el) => {
                  if (el.dataset.saBound === '1') return;
                  el.dataset.saBound = '1';

                  const input = el.querySelector('.js-sa-shipping-input');
                  const btn   = el.querySelector('.js-sa-shipping-apply');
                  const err   = el.querySelector('.js-sa-shipping-error');

                  const shippingId = el.dataset.shippingId;
                  const orig  = parseFloat(el.dataset.orig || '0');
                  const limit = parseFloat(el.dataset.limit || '0');

                  if (!input || !btn || !shippingId || !orig) return;

                  const showError = (msg) => {
                    if (err) { err.textContent = msg; err.classList.remove('d-none'); }
                    input.classList.add('is-invalid');
                  };

                  const clearError = () => {
                    if (err) { err.textContent = ''; err.classList.add('d-none'); }
                    input.classList.remove('is-invalid');
                  };

                  if (!(limit > 0)) {
                    input.disabled = true;
                    btn.disabled = true;
                    showError('Discount is disabled for this shipping method.');
                    return;
                  }

                  btn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    clearError();

                    const raw = (input.value || '').toString().trim().replace(',', '.');
                    const val = parseFloat(raw);

                    if (!Number.isFinite(val) || val < 0) {
                      showError('Enter a valid price.');
                      return;
                    }

                    const valCents  = toCents(val);
                    const origCents = toCents(orig);

                    if (valCents > origCents) {
                      showError(`Price cannot exceed ${(origCents / 100).toFixed(2)}.`);
                      return;
                    }

                      if (limit > 0 && limit < 100) {
                          const baseMin = orig * (1 - (limit / 100));
                          const minAllowedCents = Math.max(0, ceilToCents(baseMin));

                          if (valCents < minAllowedCents) {
                              showError(`Too low. Minimum allowed is ${(minAllowedCents / 100).toFixed(2)}.`);
                              return;
                          }
                      }

                    try {
                      const headers = {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                      };

                      const csrf = document.querySelector('meta[name="csrf-token"]');
                      if (csrf?.getAttribute('content')) {
                        headers['sw-csrf-token'] = csrf.getAttribute('content');
                      }

                      const body = new URLSearchParams({
                        shippingId: String(shippingId),
                        price: String(valCents / 100)
                      });

                      const resp = await fetch('/sales-agent/shipping/price', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers,
                        body
                      });

                      if (!resp.ok) {
                        let msg = 'Failed to apply shipping price.';
                        try {
                          const j = await resp.json();
                          if (j?.error) msg = j.error;
                        } catch (_e) {}
                        showError(msg);
                        return;
                      }

                      window.location.reload();
                    } catch (_err) {
                      showError('Network error applying shipping price.');
                    }
                  });
                });
              };

              const init = () => bind(document);

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init, { once: true });
              } else {
                init();
              }

              document.addEventListener('ajaxReloaded', init);

              const mo = new MutationObserver((mutations) => {
                for (const m of mutations) {
                  if (!m.addedNodes) continue;
                  for (const n of m.addedNodes) {
                    if (n?.nodeType === 1) bind(n);
                  }
                }
              });

              mo.observe(document.documentElement, { childList: true, subtree: true });
            })();
            </script>
        {% endif %}
    {% endif %}
{% endblock %}
