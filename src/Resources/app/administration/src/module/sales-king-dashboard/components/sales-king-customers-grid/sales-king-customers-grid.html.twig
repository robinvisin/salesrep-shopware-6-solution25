<mt-card>
    <template #title>
        <div style="display:flex; gap:5px;">
            {{ $tc('sales-king.dashboard.linkedCustomers') }}
            <span class="kpi-inline">({{ count }})</span>
        </div>
    </template>

    <template v-if="count > 0">
        <sw-data-grid
            :dataSource="customers"
            :columns="columns"
            :showSelection="false"
            :showActions="false"
            :isLoading="loading"
            rowKey="id"
        >
            <template #column-fullName="{ item }">
                <a
                    v-if="item.orderCustomer?.customer?.id"
                    :href="`/admin#/sw/customer/detail/${item.orderCustomer.customer.id}/base?edit=false`"
                >
                {{ item.fullName }}
            </a>
                <span v-else>{{ item.fullName }}</span>
            </template>
        </sw-data-grid>
        <sales-king-pagination
            :totalItems="count"
            :currentPage="page"
            :limit="limit"
            @page-change="goToPage"
        />
    </template>

    <template v-else>
        <div class="sw-empty-state">
            <p>
                {{ $tc('No linked customers found.') }}
            </p>
        </div>
    </template>
</mt-card>