<sw-page class="salesrep-settings__page">
    <template #smart-bar-header>
        <h2>{{ $tc('salesrep-settings.general.menuTitle') }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button-process
            :isLoading="$refs.salesrepForm && $refs.salesrepForm.isLoading"
            :processSuccess="false"
            variant="primary"
            @click="onClickSave">
            {{ $tc('salesrep-settings.general.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-settings-salesrep-form ref="salesrepForm" />
    </template>
</sw-page>
