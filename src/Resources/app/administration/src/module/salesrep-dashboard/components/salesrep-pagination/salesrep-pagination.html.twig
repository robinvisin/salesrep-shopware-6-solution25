<div class="salesrep-pagination" v-if="totalPages > 1">
    <button
        class="pagination-arrow"
        :disabled="!hasPrevious"
        @click="goToPage(currentPage - 1)"
    >
        ‹
    </button>

    <template v-for="p in visiblePages">
        <span
            v-if="p.ellipsis"
            class="pagination-page ellipsis"
            :key="p.key"
        >...</span>
        <button
            v-else
            class="pagination-page"
            :class="{ active: p.number === currentPage }"
            :key="p.key"
            @click="goToPage(p.number)"
        >
            {{ p.number }}
        </button>
    </template>

    <button
        class="pagination-arrow"
        :disabled="!hasNext"
        @click="goToPage(currentPage + 1)"
    >
        ›
    </button>
</div>
