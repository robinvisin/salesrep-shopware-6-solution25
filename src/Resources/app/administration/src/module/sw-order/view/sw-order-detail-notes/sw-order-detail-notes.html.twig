<mt-card
    title="Internal Notes"
    class="sw-order-detail-notes"
    :is-loading="isLoading"
>
    <mt-textarea
        v-model="note"
        label="Notes"
        placeholder="Write notes about this order..."
        :rows="6"
    />
    <mt-datepicker
        v-model:value="doNotShipUntil"
        dateType="date"
        label="Do not ship until after"
        placeholder="Select date"
        class="mt-3"
    />
    <mt-button
        variant="primary"
        class="mt-3"
        :loading="isSaving"
        @click="saveNotes"
    >
        Save
    </mt-button>
</mt-card>