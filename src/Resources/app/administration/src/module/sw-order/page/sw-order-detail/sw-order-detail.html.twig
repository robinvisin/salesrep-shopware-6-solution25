{% block sw_order_detail_content_tabs_extension %}
{% parent() %}

<sw-tabs-item :route="{ name: 'sw-order-detail-notes', params: { id: $route.params.id } }">
    Notes & Signature
</sw-tabs-item>

<sw-tabs-item
    :route="{ name: 'sw-order-detail-split-commission', params: { id: $route.params.id } }"
>
    Split commission
</sw-tabs-item>
{% endblock %}

{% block sw_order_detail_header_label_manual_order %}
<sw-label
    v-if="order.customFields && (order.customFields.created_by_sales_agent === true || order.customFields.created_by_sales_agent === 1 || order.customFields.created_by_sales_agent === '1')"
    appearance="pill"
    size="small"
    class="sw-order-detail__manual-order-label"
>
    {{ $tc('Created by Sales Agent') }}
    <span>: {{ createdBySalesAgentEmail }}</span>
</sw-label>

<sw-label
    v-else-if="order.createdById"
    appearance="pill"
    size="small"
    class="sw-order-detail__manual-order-label"
>
    {{ $tc('sw-order.detail.labelManualOrder') }}
</sw-label>
{% endblock %}