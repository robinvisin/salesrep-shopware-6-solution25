<sw-modal
    v-if="visible"
    :title="$tc('abandoned-cart-admin.modalTitleConfirmDelete')"
    @modal-close="close"
    class="custom-small-modal"
    size="small"
>
    <p>
        {{ $tc('abandoned-cart-admin.messageConfirmDelete') }}
    </p>
    <template #modal-footer>
        <mt-button
            @click="close"
            variant="primary" ghost
        >
            {{ $tc('abandoned-cart-admin.buttonCancel') }}
        </mt-button>
        <mt-button
            @click="confirm"
            variant="critical"
        >
            {{ $tc('abandoned-cart-admin.delete') }}
        </mt-button>
    </template>
</sw-modal>