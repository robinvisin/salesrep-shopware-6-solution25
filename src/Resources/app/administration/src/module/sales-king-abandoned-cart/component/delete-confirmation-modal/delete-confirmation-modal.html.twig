<sw-modal
    v-if="visible"
    :title="$tc('abandoned-cart-admin.modalTitleConfirmDelete')"
    @modal-close="close"
    class="custom-small-modal"
    size="small"
>
    <p>{{ $tc('abandoned-cart-admin.messageConfirmDelete') }}</p>

    <template #modal-footer>
        <sw-button @click="close" variant="ghost">
            {{ $tc('abandoned-cart-admin.buttonCancel') }}
        </sw-button>
        <sw-button @click="confirm" variant="danger">
            {{ $tc('abandoned-cart-admin.delete') }}
        </sw-button>
    </template>
</sw-modal>
