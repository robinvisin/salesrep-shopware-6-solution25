<sw-modal
    v-if="visible"
    :title="$tc('abandoned-cart-admin.modalTitleConfirmOrder')"
    @modal-close="close"
    {# class="custom-small-modal" #}
    {# size="small" #}
>
    <p>
        {{ $tc('abandoned-cart-admin.messageConfirmCreateOrder') }}
    </p>
    <template #modal-footer>
        <mt-button
            @click="close"
            variant="primary" ghost
        >
            {{ $tc('abandoned-cart-admin.buttonCancel') }}
        </mt-button>
        <mt-button
            @click="confirm"
            variant="primary"
        >
            {{ $tc('abandoned-cart-admin.buttonConfirm') }}
        </mt-button>
    </template>
</sw-modal>