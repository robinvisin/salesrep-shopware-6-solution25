<sw-modal
    v-if="visible"
    :title="$tc('abandoned-cart-admin.reminderModalTitle')"
    @modal-close="onClose"
>
    <div class="sw-field">
        <p style="margin-bottom: 10px;">
            <strong>
    {{ $tc('abandoned-cart-admin.reminderTo') }}
    :
</strong>
            {{ cart.email || '—' }}
        </p>
        <sw-switch-field
            v-model:value="includeItems"
            :label="$tc('abandoned-cart-admin.reminderIncludeItems')"
        />
        <sw-textarea-field
            v-model:value="note"
            :label="$tc('abandoned-cart-admin.reminderNoteLabel')"
            :placeholder="$tc('abandoned-cart-admin.reminderNotePlaceholder')"
            :rows="5"
            style="margin-top: 12px;"
        />
    </div>
    <template #modal-footer>
        <sw-button @click="onClose">
            {{ $tc('Cancel') }}
        </sw-button>
        <sw-button
            variant="primary"
            :isLoading="isSending"
            @click="onConfirm"
        >
            {{ $tc('abandoned-cart-admin.reminderSendButton') }}
        </sw-button>
    </template>
</sw-modal>