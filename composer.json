{
    "name": "salesrep/salesrep-shopware-6-solution25",
    "description": "Salesrep Plugin for Shopware 6 ",
    "type": "shopware-platform-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.6.0"
    },
    "extra": {
        "shopware-plugin-class": "Salesrep\\Salesrep",
        "label": {
            "de-DE": "Salesrep Plugin für Shopware 6",
            "en-GB": "Salesrep Plugin for Shopware 6"
        }
    },
    "autoload": {
        "psr-4": {
            "Salesrep\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Salesrep\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7"
    },
    "scripts": {
        "post-install-cmd": [
            "@enable-prepush"
        ],
        "post-update-cmd": [
            "@enable-prepush"
        ],
        "enable-prepush": [
            "cp ./pre-push .git/hooks/pre-push",
            "chmod +x .git/hooks/pre-push"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
