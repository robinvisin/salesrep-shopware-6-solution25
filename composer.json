{
    "name": "salesrep/salesrep-shopware-6-solution25",
    "description": "Salesrep Plugin for Shopware 6 ",
    "type": "shopware-platform-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "solution25",
            "email": "info@solution25.com",
            "homepage": "https://solution25.com/"
        }
    ],
    "require": {
        "shopware/core": "~6.6.0",
        "shopware/storefront": "~6.6.0"
    },
    "extra": {
        "shopware-plugin-class": "Salesrep\\Salesrep",
        "label": {
            "de-DE": "Salesrep Plugin für Shopware 6",
            "en-GB": "Salesrep Plugin for Shopware 6"
        },
        "description": {
            "de-DE": "Salesrep ist ein Plugin für Shopware 6, mit dem Vertriebsmitarbeiter Rabatte auf Produkte vergeben können und für jeden getätigten Verkauf eine Provision erhalten.",
            "en-GB": "Salesrep is a Shopware 6 plugin that allows sales agents to apply product discounts, manage customers, and earn commission for every successful sale they complete daily work!"
        },
        "manufacturerLink": {
            "de-DE": "https://solution25.com/",
            "en-GB": "https://solution25.com/en/home_en/"
        },
        "supportLink": {
            "de-DE": "https://solution25.com/",
            "en-GB": "https://solution25.com/en/home_en/"
        }
    },
    "autoload": {
        "psr-4": {
            "Salesrep\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Salesrep\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "post-install-cmd": [
            "@enable-prepush"
        ],
        "post-update-cmd": [
            "@enable-prepush"
        ],
        "enable-prepush": [
            "cp ./pre-push .git/hooks/pre-push",
            "chmod +x .git/hooks/pre-push"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
